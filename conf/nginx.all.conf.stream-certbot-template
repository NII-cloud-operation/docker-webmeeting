upstream ${TURN_FQDN} {
    server sfu-backend:3478;
}

upstream ${SFU_FQDN} {
    server sfu:8080;
}

upstream ${APP_FQDN} {
    server app:80;
}

upstream ${ADMIN_SUBDOMAIN}.${APP_FQDN} {
    server app:80;
}

# TODO Applying wildcard domain
upstream ${SAMPLE_TENANT_SUBDOMAIN}.${APP_FQDN} {
    server app:80;
}

map $ssl_server_name $cert_name {
    ${APP_FQDN} ${APP_FQDN};
    ${ADMIN_SUBDOMAIN}.${APP_FQDN} ${APP_FQDN};
    ${SAMPLE_TENANT_SUBDOMAIN}.${APP_FQDN} ${APP_FQDN};
    ${SFU_FQDN} ${SFU_FQDN};
    ${TURN_FQDN} ${TURN_FQDN};
    default ${APP_FQDN};
}

server {
  listen 443 ssl;
  proxy_pass $ssl_server_name;

  ssl_certificate /etc/letsencrypt/live/$cert_name/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/$cert_name/privkey.pem;
  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_prefer_server_ciphers on;
  ssl_ciphers ECDHE-RSA-AES256-GCM-SHA512:DHE-RSA-AES256-GCM-SHA512:ECDHE-RSA-AES256-GCM-SHA384:DHE-RSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-SHA384;

  ssl_handshake_timeout 10s;

  ssl_session_timeout 10m;
  ssl_session_cache shared:SSL:10m;
  ssl_session_tickets off;
}