# The settings shared by the services.
# Do not edit this file; write the values to change to override.env.

# The tag of the webmeeting-app and webmeeting-sfu images.
# A date tag (e.g. 20260601) pins the release.
# It takes effect when this file and override.env are given to docker compose with --env-file.
WEBMEETING_IMAGE_TAG=latest

# (Required) The FQDN of the application server that runs demo.jar
APP_FQDN=your_app_hostname

# The internal host name of the application server that runs demo.jar
APP_INTERNAL_HOSTNAME=app

# The IP address range from which demo.jar accesses the SFU internally
APP_IP_RANGE=0.0.0.0/0

# (Required) The FQDN of the SFU
SFU_FQDN=your_sfu_hostname

# (Required) The FQDN of the TURN server
TURN_FQDN=your_turn_hostname

# (Required) The IP address range from which the SFU accesses demo.jar internally
# IMPORTANT for security: 0.0.0.0/0 allows any address and is dangerous in production.
# Set the private address range in use (e.g. 172.16.0.0/12, 10.0.0.0/8, 192.168.0.0/16).
SFU_IP_RANGE=0.0.0.0/0

# (Required for ACME) The contact email address of the ACME account
#ACME_EMAIL=your_email@example.com

# The ACME certificate authority. The UPKI overlay overrides it with the URL of UPKI.
ACME_DIRECTORY=https://acme-v02.api.letsencrypt.org/directory

# The name of the persistent state that separates the ACME accounts and the certificates.
# Use a different name when switching between staging and production or between certificate authorities.
ACME_STATE_NAME=letsencrypt-production

# The ACME state directory on the host
ACME_STATE_DIR=/var/lib/webmeeting/acme

# The directory of the UPKI EAB credentials on the host
UPKI_ACME_EAB_DIR=/var/lib/webmeeting/secrets/upki-acme

# The key type; match the certificate profile chosen when the EAB credential was issued (rsa or ecdsa).
ACME_KEY_TYPE=rsa
# When the profile differs by domain, override it for each domain below.
#ACME_KEY_TYPE_APP=rsa
#ACME_KEY_TYPE_ADMIN=rsa
#ACME_KEY_TYPE_SAMPLE=rsa
#ACME_KEY_TYPE_SFU=rsa
#ACME_KEY_TYPE_TURN=rsa

# The interval of the renewal check of Certbot. Certbot 4.1 or later also follows the ARI of the CA.
ACME_RENEW_INTERVAL=12h

# The UPKI overlay sets it to true.
ACME_EAB_REQUIRED=false

# The file names of the Key IDs and the HMAC keys in the UPKI EAB directory
ACME_EAB_APP_KID_FILE=app.kid
ACME_EAB_APP_HMAC_KEY_FILE=app.hmac
ACME_EAB_ADMIN_KID_FILE=admin.kid
ACME_EAB_ADMIN_HMAC_KEY_FILE=admin.hmac
ACME_EAB_SAMPLE_KID_FILE=sample.kid
ACME_EAB_SAMPLE_HMAC_KEY_FILE=sample.hmac
ACME_EAB_SFU_KID_FILE=sfu.kid
ACME_EAB_SFU_HMAC_KEY_FILE=sfu.hmac
ACME_EAB_TURN_KID_FILE=turn.kid
ACME_EAB_TURN_HMAC_KEY_FILE=turn.hmac

# The path of the certificate for HTTPS. If CA certificates are required, concatenate them all into this file.
CERT_PATH=/etc/nginx/cert/your-server.crt

# The path of the private key for HTTPS
KEY_PATH=/etc/nginx/cert/your-server.key

#########################
# Common settings
#########################

# Please set the URL to which this site will be served.
# DO NOT INCLUDE TENANT SUBDOMAIN
SERVICE_HOST=https://your_host_name

# Profile images placed path
PHOTO_ROOT_DIR=/opt/demo/profile_images

# Import CSV tempolary placed path
IMPORT_ROOT_DIR=/opt/demo/data_import_tmp

# If you set true, you can delete tenant.
# However we don't recommend it.
TENANT_DELETABLE=false

### Admin tenant subdomain
# We recommended to change this for security reasons.
# DO NOT CHANGE AFTER INITIALIZED
ADMIN_SUBDOMAIN=admin

### Initial admin password
# Required on the first start: the account "admin" of the admin tenant is created
# with this password, and the app does not start without it.
# Set it in override.env. It is not used once the account exists.
ADMIN_INITIAL_PASSWORD=

#########################
# SFU settings
#########################

# SFU Signaling URL
SORA_SIGNALING_URL=wss://your_sfu_server_hostname/signaling

# SFU webhook path prefix
# If you set to "/sfu/webhook".
# Auth webhook path is /sfu/webhook/auth
# Event webhook path is /sfu/webhook/event
SORA_WEBHOOK_PATH=/sora/webhook

# SFU API URL
SORA_API_URL=http://sfu/api

#########################
# Database settings
#########################

# If you use H2, DB_USERNAME and DB_PASSWORD can be commented out.
# The postgresql service is created with these values. Set your own password in override.env
# before the first start; changing it later does not change the password in the existing database.
DB_USERNAME=webmeetinguser
DB_PASSWORD=webmeetingpassword

### Initialize

# initialize => create
# normal => none
# IF YOU SET TO INITIALIZE, ALL DATAS WILL BE CLEARED!
DB_DDL_AUTO=update

# initialize => always
# normal => never
# IF YOU SET TO INITIALIZE, ALL DATAS WILL BE CLEARED!
SQL_INIT_MODE=always

### DB Settings

# H2
# DB_DRIVER=org.h2.Driver
# # YOU MUST SET `;MODE=PostgreSQL;` AT THE END OF THE STATEMENT.
# DB_URL=jdbc:h2:./testdb;MODE=PostgreSQL;

# PostgreSQL
DB_DRIVER=org.postgresql.Driver
DB_URL=jdbc:postgresql://postgresql:5432/webmeeting

#########################
# Mail settings
#########################

# If you set this to false, all mail related functions will be hidden.
MAIL_ENABLED=false

MAIL_FROM_ADDRESS=mail_from_address
MAIL_HOST=smtp_server_hostname
MAIL_PORT=80
MAIL_USERNAME=mail_username
MAIL_PASSWORD=mail_password
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS_ENABLE=true
MAIL_SMTP_STARTTLS_REQUIRED=true
MAIL_DEBUG=true

#########################
# Other settings
#########################

DEBUG=false
FORMAT_SQL=false
LOG_LEVEL=INFO
COOKIE_SECURE=true
JAVA_OPTS='-Duser.timezone=UTC -Djava.awt.headless=true'

# The subdomain of the trial tenant - ${SAMPLE_TENANT_SUBDOMAIN}.${APP_FQDN}
# https-proxy also routes the connections to this subdomain to app.
SAMPLE_TENANT_SUBDOMAIN=sample
